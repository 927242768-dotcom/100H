###==== BEGIN "set_multicycle_path"
set_multicycle_path -to [get_cells -hier {*processed_word_reg*}] -setup 3 -end
set_multicycle_path -to [get_cells -hier {*processed_word_reg*}] -hold 2 -end
set_multicycle_path -to [get_cells -hier {*final_word_reg*}] -setup 3 -end
set_multicycle_path -to [get_cells -hier {*final_word_reg*}] -hold 2 -end
###==== END "set_multicycle_path"

